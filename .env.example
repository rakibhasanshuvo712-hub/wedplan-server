# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# MongoDB Database URI
DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wedplan?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Stripe Payment (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Initial Seed Admin Account (Used for Live Evaluation)
ADMIN_EMAIL=admin@wedplan.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Platform Admin

# ImgBB API Key (Image Hosting)
IMGBB_API_KEY=your_imgbb_api_key_here
