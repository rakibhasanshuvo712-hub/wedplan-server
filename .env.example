# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# MongoDB Database URI
DB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wedplan?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google Identity Services (public Client ID only — no client secret required)
# Used by POST /api/auth/google to verify tokens with Google.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Better Auth redirect-based Google social login (optional — used by the mounted
# /api/auth/social/* endpoints). This flow exchanges an authorization code and
# therefore needs BOTH values. The client ID must be the one the secret belongs to.
GOOGLE_SOCIAL_CLIENT_ID=your_google_social_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Better Auth (optional — used for the mounted social endpoints)
BETTER_AUTH_SECRET=your_better_auth_secret_here
BETTER_AUTH_URL=https://your-backend-domain.vercel.app

# Stripe Payment (Test Mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Initial Seed Admin Account (Used for Live Evaluation)
ADMIN_EMAIL=admin@wedplan.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Platform Admin

# ImgBB API Key (Image Hosting)
IMGBB_API_KEY=your_imgbb_api_key_here
